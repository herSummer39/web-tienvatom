# Supabase (Tạo project miễn phí tại supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mật khẩu đăng nhập trang /admin (BẮT BUỘC đặt; để trống = khóa trang quản trị)
ADMIN_PASSWORD=

# Automation Webhook (n8n / Make / Zalo OA / Fanpage Webhook)
LEAD_WEBHOOK_URL=

# Thông báo nhanh về Telegram (tùy chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Chatbot (tùy chọn - nếu để trống sẽ dùng chế độ tư vấn thông minh có sẵn)
OPENAI_API_KEY=

# Tên miền chính thức sau khi gắn domain (dùng cho sitemap.xml & llms.txt)
NEXT_PUBLIC_SITE_URL=http://localhost:6688

# Microsoft Clarity: mã dự án (Settings -> Setup), để trống = không gắn
NEXT_PUBLIC_CLARITY_ID=
